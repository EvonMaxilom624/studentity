      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "enum": [
              400,
              401,
              403,
              404,
              409,
              419,
              422,
              429,
              500,
              503
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "bad_request",
              "conflict",
              "authentication_required",
              "permission_denied",
              "not_found",
              "csrf_mismatch",
              "validation_failed",
              "throttled",
              "security_state_unavailable",
              "internal_error"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlationId"
        ],
        "additionalProperties": false
      },
      "SelfUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "systemId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque verified issuer reference for students, null for nonstudents or pre-issuance state. DTO output never proves issuance."
          },
          "accountState": {
            "type": "string",
            "enum": [
              "provisional",
              "active",
              "inactive",
              "withdrawn",
              "graduated",
              "disabled"
            ]
          },
          "effectiveRoles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "systemId",
          "accountState"
        ],
        "additionalProperties": false
      },
      "ActionResult": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "accepted"
        ],
        "additionalProperties": false
      },
      "EmailVerifyInput": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "oneTimeCode": {
            "type": "string",
            "minLength": 4,
            "maxLength": 12
          }
        },
        "required": [
          "challengeId",
          "oneTimeCode"
        ],
        "additionalProperties": false
      },
      "SessionResult": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "mfaPending": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "authenticated",
          "mfaPending"
        ],
        "additionalProperties": false
      },
      "EmailOtpStartInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      },
      "Challenge": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "PasswordLoginInput": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "password"
        ],
        "additionalProperties": false
      },
      "RegisterInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 256,
            "pattern": "^[!-~]+$(?![\\s\\S])"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 72,
            "pattern": "^[^\\u0000]+$",
            "x-maxUtf8Bytes": 72,
            "writeOnly": true,
            "description": "Optional; 10+ characters and at most72UTF8 bytes for existing bcrypt-compatible boundary. No raw-password retention; approved strength policy remains separate."
          },
          "termsVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[!-~]+$(?![\\s\\S])",
            "description": "Opaque current version reference, resolved to accepted text/hash/history by server."
          },
          "noticeVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[!-~]+$(?![\\s\\S])",
            "description": "Opaque current version reference, resolved to accepted text/hash/history by server."
          },
          "acknowledged": {
            "type": "boolean",
            "const": true,
            "description": "Acknowledgment of exact current approved notice versions; not automatic processing consent."
          },
          "programId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
          },
          "classification": {
            "type": "string",
            "enum": [
              "Incoming Freshman",
              "Continuing/Regular",
              "Transferee",
              "Returning/Readmission",
              "Shiftee",
              "Second-Course"
            ]
          },
          "departmentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
          },
          "yearLevel": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647,
            "description": "Must match server-resolved accepted academic year values; no institutional range inferred."
          }
        },
        "required": [
          "email",
          "termsVersion",
          "noticeVersion",
          "acknowledged",
          "programId",
          "classification",
          "departmentId",
          "yearLevel"
        ],
        "additionalProperties": false
      }
    }
  }
}
